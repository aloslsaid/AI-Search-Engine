# Required
TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=
OWNER_ID=

# Optional web search
SERPAPI_API_KEY=

# AI
OPENROUTER_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition
TEMPERATURE=0.8
MAX_OUTPUT_TOKENS=2048
AI_TIMEOUT_SECONDS=120
MAX_INPUT_CHARS=4000
MAX_PROMPT_LENGTH=4000
APPEND_DATE_TO_PROMPT=true

# Usage limits (0 = unlimited)
DAILY_AI_LIMIT=50
DAILY_SEARCH_LIMIT=30
DAILY_RESET_UTC_OFFSET=3

# Anti-spam
MIN_INTERVAL_SECONDS=1.5
BURST_MAX=8
BURST_WINDOW_SECONDS=20
COOLDOWN_SECONDS=60

# Conversation memory
MAX_HISTORY_MESSAGES=20
MAX_HISTORY_CHARS=24000

# Search
SEARCH_RESULTS_COUNT=8
SEARCH_TIMEOUT_SECONDS=40
SERPAPI_HL=en
SERPAPI_GL=
IMAGE_HOST=litterbox

# Runtime
DB_PATH=data/infinitrix.db
LOG_LEVEL=INFO
APP_URL=https://github.com/aloslsaid/AI-Search-Engine
